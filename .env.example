# ============================================================
# 日历应用环境变量配置示例
# ============================================================
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env 填写实际值
#
# Docker Compose 会自动读取同目录下的 .env 文件。
# .env 文件已被 .gitignore 忽略，不会提交到版本控制。
#
# 生成强随机 SECRET_KEY：
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ---- 安全配置（必填）----
# Flask 密钥：生产环境必须替换为强随机值
SECRET_KEY=

# 管理员默认密码（仅首次初始化时生效，留空则自动生成随机密码）
# 设置后首次启动的容器日志中会打印该密码
ADMIN_DEFAULT_PASSWORD=

# ---- CORS 跨域配置 ----
# 允许的跨域来源（逗号分隔的完整 URL 列表）
# 开发环境留空（允许所有来源）；生产环境必须设置为具体域名
# 示例：https://your-domain.com,https://www.your-domain.com
CALENDAR_CORS_ORIGINS=

# ---- 备案信息（生产环境填写）----
# ICP 备案号，如：XICP备XXXXXXXXXX号-X
ICP_NUMBER=
# 公安备案号，如：X公网安备 XXXXXXXXXXXX号
PUBLIC_SECURITY_NUMBER=

# ---- 数据库配置 ----
# 数据库类型：sqlite 或 mysql
CALENDAR_DB_TYPE=sqlite

# ---- MySQL 密码（仅 CALENDAR_DB_TYPE=mysql 时需要）----
# 生产环境必须替换为强密码！
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ---- AI 周报/月报（可选，未配置时自动降级为统计型报告）----
# 是否启用 AI 报告：1/true 启用，0/false 关闭
AI_REPORT_ENABLED=1
# 服务类型：openai-compatible（OpenAI 兼容协议）或 ollama（本地 Ollama）
AI_PROVIDER=openai-compatible
# API 地址（结尾不带 /v1）：
#   OpenAI 官方：https://api.openai.com/v1
#   DeepSeek：https://api.deepseek.com/v1
#   阿里通义：https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama：http://host.docker.internal:11434
AI_API_BASE=https://api.openai.com/v1
# API Key（Ollama 可留空）
AI_API_KEY=
# 模型名，如 gpt-4o-mini / deepseek-chat / qwen-plus / llama3.1
AI_MODEL=gpt-4o-mini
# 请求超时（秒）与最大生成长度（输出被截断时可调大，后端会自动用双倍额度重试一次）
AI_TIMEOUT=60
AI_MAX_TOKENS=4096
# 每个用户每月 AI 报告生成次数上限（仅 AI 成功调用计数，降级统计报告不消耗）
AI_MONTHLY_LIMIT=20
